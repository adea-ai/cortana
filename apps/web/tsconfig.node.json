{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "vite.config.ts",
    "src/themeBoot.ts",
    "src/theme.ts",
    "tooling/generate-ui-tailwind-sources.ts",
    "tooling/ui-tailwind-sources.ts",
    "tooling/ui-tailwind-sources.test.ts"
  ]
}
