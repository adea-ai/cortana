{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "jsPlugins": ["@shadcn/lint", "@adea-ai/ui/lint"],
  "settings": {
    "shadcn": {
      "ui": "@adea-ai/ui/components",
      "note": "Import shared primitives from @adea-ai/ui. App styles own native-domain layout only."
    }
  },
  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "message": "Use SolidJS primitives (createSignal/createEffect/For/Show) instead of React."
          },
          {
            "name": "react-dom",
            "message": "Use SolidJS primitives (createSignal/createEffect/For/Show) instead of React."
          },
          {
            "name": "lucide-react",
            "message": "Use lucide-solid for icons."
          },
          {
            "name": "cmdk",
            "message": "Use shared command components from @adea-ai/ui."
          },
          {
            "name": "sonner",
            "message": "Use the application Solid toast adapter."
          },
          {
            "name": "next-themes",
            "message": "Use the application theme integration with @adea-ai/ui tokens."
          },
          {
            "name": "react-resizable-panels",
            "message": "Use Resizable from @adea-ai/ui/components/ui/resizable."
          },
          {
            "name": "@base-ui/react",
            "message": "Import shared primitives from @adea-ai/ui/components/ui/*."
          }
        ],
        "patterns": [
          {
            "group": ["@base-ui/*", "@base-ui-components/*", "@radix-ui/*", "radix-*"],
            "message": "Import primitives from @adea-ai/ui/components/ui/*; do not use direct primitive libraries."
          },
          {
            "group": ["@kobalte/*"],
            "message": "Import primitives from @adea-ai/ui/components/ui/*; do not use direct primitive libraries."
          }
        ]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "eslint/no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "depth": 5,
        "controlComponents": ["Checkbox", "Input", "Select"]
      }
    ],
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "promise/always-return": "warn",
    "promise/no-callback-in-promise": "warn",
    "shadcn/no-restyle": [
      "error",
      {
        "deny": ["color", "typography", "shape", "effects", "motion", "spacing"]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "adea/no-raw-interactive-elements": "error",
    "adea/no-primitive-library-imports": "error",
    "adea/no-interactive-wrappers": "error",
    "adea/no-inline-styles": "error",
    "adea/no-class-list": "error",
    "adea/require-action-button-tooltip": "error"
  },
  "overrides": [],
  "ignorePatterns": ["node_modules/**", "apps/web/dist/**", "coverage/**", "target/**"]
}
